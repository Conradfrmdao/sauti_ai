NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=

# Reasoning provider. Gemini is the default and serves every channel: it
# benchmarks at ~1.6s on a real turn against 12-27s for the free OpenRouter
# models, and voice cannot tolerate more -- Gemini Live stays silent until the
# turn returns, so latency here is dead air on the call.
# Set to "openrouter" to make OpenRouter primary instead.
REASONING_PROVIDER=gemini

GEMINI_API_KEY=
# Failover chain, ordered by measured latency and reliability rather than
# version number. Gemini returns 503 "high demand" often enough that a single
# model is not a plan. Leave blank for the built-in chain.
GEMINI_MODELS=
# Gemini Live handles the realtime audio itself (barge-in, transcription).
# Comma-separated; the fallback is always appended, so a 503 on the newest
# model cannot stop a call from starting. Verified to accept SAUTI1's session
# config: gemini-3.8-live, gemini-3.1-flash-live-preview,
# gemini-2.5-flash-native-audio-latest (most natural speech),
# gemini-3.8-live-extended-thinking.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview

# OpenRouter is optional and OFF unless switched on, so a stray key cannot put
# slow models on the voice path. Set true to keep it as a backstop behind
# Gemini, or set REASONING_PROVIDER=openrouter to lead with it.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_TIMEOUT_MS=28000

# Deadlines for a turn somebody is waiting on in silence (voice and guest).
REALTIME_TURN_BUDGET_MS=14000
REALTIME_MODEL_TIMEOUT_MS=12000
REALTIME_MAX_OUTPUT_TOKENS=800

# Serve text chat from the realtime path too. With Gemini primary this is
# already fast, so "realtime" mainly caps how long a text turn may take.
TEXT_LATENCY_MODE=standard

# How many follow-up questions SAUTI1 may ask before it must work with what it
# has. Without a ceiling the model finds "one more blocking fact" forever.
MAX_FOLLOW_UP_QUESTIONS=4

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_SECRET=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_MEDIA_STREAM_URL=

INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER_NUMBER=
INFOBIP_WEBHOOK_USERNAME=
INFOBIP_WEBHOOK_PASSWORD=

CRON_SECRET=

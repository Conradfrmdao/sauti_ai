NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=

# Reasoning provider. SAUTI1 routes all text understanding through OpenRouter,
# so the model is configuration rather than an architectural commitment.
OPENROUTER_API_KEY=
# Comma-separated failover chain for the main reasoning path. The first model
# that answers wins; a rate-limited or failing model is skipped temporarily.
# Leave blank to use the built-in free-tier chain.
OPENROUTER_MODELS=
# Shorter chain for the public guest replies, which need speed over depth.
OPENROUTER_FAST_MODELS=
OPENROUTER_TIMEOUT_MS=28000
GUEST_TIMEOUT_MS=7000

# Gemini serves the voice channel: the Live API for the audio itself, and the
# reasoning for each spoken turn. Gemini Live stays silent until the turn result
# arrives, and the free OpenRouter models take 12-27s on that call, so a live
# turn would strand the caller in silence. Measured on Gemini: ~2s.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_REALTIME_MODEL=gemini-3.5-flash-lite

# Deadlines for a turn somebody is waiting on in silence (voice and guest).
REALTIME_TURN_BUDGET_MS=14000
REALTIME_MODEL_TIMEOUT_MS=12000
REALTIME_MAX_OUTPUT_TOKENS=800

# Text chat uses OpenRouter by default. Set to "realtime" to serve text from the
# fast provider too, trading Gemini tokens for a much shorter wait.
TEXT_LATENCY_MODE=standard

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_SECRET=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_MEDIA_STREAM_URL=

INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER_NUMBER=
INFOBIP_WEBHOOK_USERNAME=
INFOBIP_WEBHOOK_PASSWORD=

CRON_SECRET=
